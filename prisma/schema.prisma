// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(cuid())
  name        String
  nameKana    String?  // ふりがな
  employeeId  String?  // 職員番号/学籍番号
  mailingList Boolean  @default(false) // メーリングリスト登録
  email       String   @unique
  password    String
  passwordResetTokenHash      String?
  passwordResetTokenExpiresAt DateTime?
  department  String?  // 学部など
  laboratory  String?  // 研究室 (旧 affiliation)
  extension   String?  // 内線
  role        String   @default("USER") // USER, ADMIN
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reservations Reservation[]
  usageLogs    UsageLog[]
  invoices     Invoice[]
  sealedInvoices Invoice[] @relation("Sealer")
  sealImage    String? // 印鑑画像のパス
  auditLogs    AuditLog[]
  adminNotificationsTarget AdminNotification[] @relation("AdminNotificationTarget")
  adminNotificationReads   AdminNotificationRead[] @relation("AdminNotificationReader")

  @@index([passwordResetTokenHash])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorName   String
  actorRole   String
  action      String
  targetType  String
  targetId    String?
  targetLabel String?
  summary     String
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

model AdminNotification {
  id           String   @id @default(cuid())
  type         String
  targetUserId String?
  name         String
  department   String?
  laboratory   String?
  employeeId   String?
  fiscalYear   Int?
  quarter      Int?
  dedupeKey    String?  @unique
  resolvedAt   DateTime?
  createdAt    DateTime @default(now())

  targetUser User?                  @relation("AdminNotificationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  reads      AdminNotificationRead[]

  @@index([createdAt])
  @@index([targetUserId, createdAt])
}

model AdminNotificationRead {
  id             String   @id @default(cuid())
  notificationId String
  adminId        String
  readAt         DateTime @default(now())

  notification AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  admin        User              @relation("AdminNotificationReader", fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([notificationId, adminId])
  @@index([adminId, readAt])
}

model AuthThrottle {
  id              String   @id @default(cuid())
  kind            String
  key             String
  attemptCount    Int      @default(0)
  windowStartedAt DateTime @default(now())
  lockedUntil     DateTime?
  updatedAt       DateTime @updatedAt

  @@unique([kind, key])
  @@index([lockedUntil])
  @@index([updatedAt])
}

model Equipment {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String?  // アイコンファイルのパス
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reservations Reservation[]
}

model Reservation {
  id          String   @id @default(cuid())
  equipmentId String
  userId      String
  startTime   DateTime
  endTime     DateTime
  status      String   @default("active") // active, cancelled, rejected
  phoneNumber String?  // Optional contact number (Added for better communication)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([equipmentId, startTime, endTime])
  @@index([userId, startTime])
}

model Reagent {
  id        String   @id @default(cuid())
  name      String
  unitPrice Float
  stock     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usageLogs UsageLog[]
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  reagentId String
  quantity  Int
  totalCost Float
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  reagent Reagent @relation(fields: [reagentId], references: [id])
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  
  // 期間情報
  fiscalYear    Int      // 年度
  quarter       Int      // 四半期 (1, 2, 3)
  startDate     DateTime
  endDate       DateTime
  
  // 金額情報
  totalAmount   Float
  
  // 請求書情報
  issuedDate    DateTime @default(now())
  status        String   @default("draft") // draft, issued, paid
  
  // 支出予算情報（任意）
  budgetDepartment String?
  budgetCategory   String?
  budgetCode       String?
  
  // 関連データ
  items         InvoiceItem[]
  
  // 電子印
  sealedBy      String?  // 押印したユーザーID
  sealer        User?    @relation("Sealer", fields: [sealedBy], references: [id])
  sealedAt      DateTime? // 押印日時

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  date        DateTime
  itemName    String   // 利用項目名
  unitPrice   Float    // 単価
  quantity    Int      // 個数
  amount      Float    // 合計
  
  // 元データへの参照（任意）
  reservationId String?
  reagentLogId  String?
  
  createdAt   DateTime @default(now())
}
